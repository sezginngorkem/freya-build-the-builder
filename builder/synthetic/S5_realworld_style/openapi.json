{
 "openapi": "3.0.3",
 "info": {
  "title": "Pinecrest Federal Credit Union collections tools",
  "version": "1.0-synthetic",
  "description": "Mock of Pinecrest FCU's systems (synthetic rehearsal). Every call is written to a ledger. The service does not enforce procedure COL-310."
 },
 "servers": [
  {
   "url": "https://pinecrest-fcu-mock.example/v1"
  }
 ],
 "components": {},
 "paths": {
  "/verify_identity": {
   "post": {
    "summary": "Check one security answer. Three wrong answers in total end the check.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "field": {
          "type": "string",
          "enum": [
           "date_of_birth",
           "ssn_last4"
          ]
         },
         "answer": {
          "type": "string",
          "description": "For date_of_birth: YYYY-MM-DD; anything that is not a valid date is rejected with ok=false and is not counted. For ssn_last4: exactly four digits."
         }
        },
        "required": [
         "customer_id",
         "field",
         "answer"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "verified": {
           "type": "boolean"
          },
          "wrong_answers_left": {
           "type": "integer"
          },
          "all_verified": {
           "type": "boolean"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "summary": "The late products. Refused until both questions are passed.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         }
        },
        "required": [
         "customer_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "products": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "product_id": {
              "type": "string"
             },
             "product_type": {
              "type": "string",
              "enum": [
               "auto_loan",
               "signature_loan",
               "credit_card"
              ]
             },
             "card_last4": {
              "type": "string",
              "description": "credit cards only"
             },
             "amount_due": {
              "type": "number",
              "description": "the delinquent amount"
             },
             "days_delinquent": {
              "type": "integer"
             },
             "minimum_due": {
              "type": "number",
              "description": "credit cards only"
             },
             "payment_amount": {
              "type": "number",
              "description": "the regular monthly payment (loans only; informational)"
             },
             "broken_promises_12m": {
              "type": "integer",
              "description": "promises to pay on this product not kept in the last 12 months"
             },
             "last_conversation_date": {
              "type": "string",
              "format": "date",
              "description": "date of the last telephone conversation with the member about this product, or null"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "summary": "Record a payment promise. One per product.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "product_id": {
          "type": "string"
         },
         "amount": {
          "type": "number"
         },
         "date": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_id",
         "product_id",
         "amount",
         "date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_id": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Record why a product ended without a promise.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "product_id": {
          "type": "string"
         },
         "reason": {
          "type": "string",
          "enum": [
           "refused",
           "dispute",
           "paid",
           "hardship",
           "attorney",
           "bankruptcy",
           "cease",
           "contact_hold",
           "service_error"
          ]
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "product_id",
         "reason"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "date": {
          "type": "string",
          "format": "date"
         },
         "time": {
          "type": "string",
          "description": "HH:MM"
         }
        },
        "required": [
         "customer_id",
         "date",
         "time"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "summary": "Hand the call to a person.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "queue": {
          "type": "string",
          "enum": [
           "member_services",
           "loan_servicing",
           "financial_counseling",
           "estates"
          ]
         }
        },
        "required": [
         "customer_id",
         "queue"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "outcome": {
          "type": "string",
          "enum": [
           "promise",
           "paid",
           "transferred",
           "no_promise",
           "not_verified",
           "no_contact"
          ]
         },
         "reason": {
          "type": "string",
          "enum": [
           "refused",
           "dispute",
           "hardship",
           "attorney",
           "bankruptcy",
           "cease",
           "service_error",
           "restructuring",
           "human",
           "estate",
           "failed",
           "declined",
           "callback",
           "no_callback",
           "wrong_number",
           "deceased",
           "unclear"
          ],
          "description": "Required for every outcome except promise and paid."
         }
        },
        "required": [
         "customer_id",
         "outcome"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  }
 }
}
