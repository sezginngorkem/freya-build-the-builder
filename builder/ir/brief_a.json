 "procedures": {
  "identify_ask_again": [
   {
    "incr": "var.identify_asks"
   },
   {
    "if": "var.identify_asks >= 2",
    "then": [
     {
      "say": "unclear_bye"
     },
     {
      "close": {
       "outcome": "'not_reached'",
       "reason": "'unclear'"
      }
     }
    ],
    "else": [
     {
      "say": "ask_identity_again",
      "prompt": true
     }
    ]
   }
  ],
  "check_callback": [
   {
    "if": "(var.cb_date == today or var.cb_date == next_business_day(today)) and time_in_window(var.cb_time, '10:00', '19:00') and (var.cb_date > today or var.cb_time > now_time())",
    "then": [
     {
      "call": "schedule_callback",
      "args": {
       "customer_id": "call.customer_id",
       "date": "var.cb_date",
       "time": "var.cb_time"
      }
     },
     {
      "say": "tp_callback_done"
     },
     {
      "close": {
       "outcome": "'not_reached'",
       "reason": "'callback'"
      }
     }
    ],
    "else": [
     {
      "incr": "var.cb_bad"
     },
     {
      "if": "var.cb_bad >= 2",
      "then": [
       {
        "say": "tp_no_callback_bye"
       },
       {
        "close": {
         "outcome": "'not_reached'",
         "reason": "'no_callback'"
        }
       }
      ],
      "else": [
       {
        "set": {
         "var.cb_date": "None",
         "var.cb_time": "None"
        }
       },
       {
        "say": "tp_other_time",
        "prompt": true
       }
      ]
     }
    ]
   }
  ],
  "after_verify_dob": [
   {
    "if": "result.verified",
    "then": [
     {
      "goto": "verify_phone"
     }
    ],
    "else": [
     {
      "if": "result.hint == 'day_month_swapped'",
      "then": [
       {
        "say": "ask_month_word",
        "prompt": true
       }
      ],
      "else": [
       {
        "if": "result.ok == false and not is_set(result.wrong_answers_left)",
        "then": [
         {
          "say": "ask_dob_repeat",
          "prompt": true
         }
        ],
        "else": [
         {
          "incr": "var.wrong"
         },
         {
          "run": "wrong_answer",
          "_": "dob"
         }
        ]
       }
      ]
     }
    ]
   }
  ],
  "after_verify_phone": [
   {
    "if": "result.verified or result.all_verified",
    "then": [
     {
      "set": {
       "flag.verified": "true"
      }
     },
     {
      "goto": "account"
     }
    ],
    "else": [
     {
      "if": "result.ok == false and not is_set(result.wrong_answers_left)",
      "then": [
       {
        "say": "ask_phone_repeat",
        "prompt": true
       }
      ],
      "else": [
       {
        "incr": "var.wrong"
       },
       {
        "run": "wrong_answer_phone"
       }
      ]
     }
    ]
   }
  ],
  "wrong_answer": [
   {
    "if": "var.wrong >= 3 or result.wrong_answers_left == 0",
    "then": [
     {
      "say": "fail_identity"
     },
     {
      "close": {
       "outcome": "'not_verified'",
       "reason": "'failed'"
      }
     }
    ],
    "else": [
     {
      "say": "ask_dob_again",
      "prompt": true
     }
    ]
   }
  ],
  "wrong_answer_phone": [
   {
    "if": "var.wrong >= 3 or result.wrong_answers_left == 0",
    "then": [
     {
      "say": "fail_identity"
     },
     {
      "close": {
       "outcome": "'not_verified'",
       "reason": "'failed'"
      }
     }
    ],
    "else": [
     {
      "say": "ask_phone_again",
      "prompt": true
     }
    ]
   }
  ],
  "declined": [
   {
    "incr": "var.declines"
   },
   {
    "if": "var.declines >= 2",
    "then": [
     {
      "say": "declined_bye"
     },
     {
      "close": {
       "outcome": "'not_verified'",
       "reason": "'declined'"
      }
     }
    ],
    "else": [
     {
      "say": "protect"
     },
     {
      "reprompt": true
     }
    ]
   }
  ],
  "evaluate_proposal": [
   {
    "set": {
     "var.cust_amount": "slot.promise_amount if is_set(slot.promise_amount) else None",
     "var.cust_date": "slot.promise_date if is_set(slot.promise_date) else None"
    }
   },
   {
    "if": "is_set(var.cust_amount) and var.cust_amount < item.floor",
    "then": [
     {
      "if": "not item.floor_offered",
      "then": [
       {
        "set": {
         "item.floor_offered": "true",
         "var.offer_amount": "item.floor",
         "var.offer_date": "var.cust_date if is_set(var.cust_date) and is_business_day(var.cust_date) and date_ge(var.cust_date, today) and date_le(var.cust_date, item.deadline) else var.offer_date"
        }
       },
       {
        "say": "below_floor",
        "prompt": true
       }
      ],
      "else": [
       {
        "run": "refusal"
       }
      ]
     }
    ],
    "else": [
     {
      "set": {
       "var.offer_amount": "min(var.cust_amount, item.past_due) if is_set(var.cust_amount) else var.offer_amount"
      }
     },
     {
      "if": "not is_set(var.cust_date)",
      "then": [
       {
        "if": "is_set(var.cust_amount) and var.offer_kind == 'today'",
        "then": [
         {
          "say": "ask_day_for_amount",
          "prompt": true
         }
        ],
        "else": [
         {
          "set": {
           "var.pa_amount": "var.offer_amount",
           "var.pa_date": "var.offer_date"
          }
         },
         {
          "run": "accept"
         }
        ]
       }
      ],
      "else": [
       {
        "if": "date_lt(var.cust_date, today)",
        "then": [
         {
          "say": "past_date",
          "prompt": true
         }
        ],
        "else": [
         {
          "if": "date_lt(item.deadline, var.cust_date)",
          "then": [
           {
            "set": {
             "var.offer_date": "item.deadline",
             "var.offer_kind": "'deadline'"
            }
           },
           {
            "say": "after_deadline",
            "prompt": true
           }
          ],
          "else": [
           {
            "if": "not is_business_day(var.cust_date)",
            "then": [
             {
              "set": {
               "var.offer_date": "min_date(next_business_day(var.cust_date), item.deadline)",
               "var.offer_kind": "'next_business_day'"
              }
             },
             {
              "say": "not_business_day",
              "prompt": true
             }
            ],
            "else": [
             {
              "set": {
               "var.pa_amount": "var.offer_amount",
               "var.pa_date": "var.cust_date"
              }
             },
             {
              "run": "accept"
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  ],
  "refusal": [
   {
    "if": "var.hardship",
    "then": [
     {
      "run": "end_hardship"
     }
    ],
    "else": [
     {
      "if": "item.attempts < item.attempts_limit",
      "then": [
       {
        "incr": "item.attempts"
       },
       {
        "if": "item.attempts == 1",
        "then": [
         {
          "set": {
           "var.offer_amount": "item.floor if item.too_much else item.past_due",
           "var.offer_date": "last_business_day_of_week(today, 1) if last_business_day_of_week(today, 0) == today else last_business_day_of_week(today, 0)",
           "var.offer_kind": "'attempt1'"
          }
         }
        ],
        "else": [
         {
          "set": {
           "var.offer_amount": "item.floor",
           "var.offer_date": "item.deadline",
           "var.offer_kind": "'attempt2'"
          }
         }
        ]
       },
       {
        "say": "offer",
        "prompt": true
       }
      ],
      "else": [
       {
        "run": "end_refused"
       }
      ]
     }
    ]
   }
  ],
  "accept": [
   {
    "goto": "confirm"
   }
  ],
  "end_refused": [
   {
    "say": "refused_bye"
   },
   {
    "close": {
     "outcome": "'no_promise'",
     "reason": "'refused'"
    }
   }
  ],
  "end_hardship": [
   {
    "say": "hardship_bye"
   },
   {
    "close": {
     "outcome": "'no_promise'",
     "reason": "'hardship'"
    }
   }
  ],
  "end_paid": [
   {
    "say": "paid_bye"
   },
   {
    "close": {
     "outcome": "'paid'"
    }
   }
  ],
  "end_dispute": [
   {
    "say": "dispute_bye"
   },
   {
    "close": {
     "outcome": "'no_promise'",
     "reason": "'dispute'"
    }
   }
  ]
 },
 "functions": {
  "product_label": {
   "params": [
    "p"
   ],
   "expr": "('credit card ending ' + str_(p.card_last4)) if p.type == 'credit_card' else ('personal loan' if p.type == 'personal_loan' else ('car loan' if p.type == 'car_loan' else p.type))",
   "src": "A17"
  },
  "product_floor": {
   "params": [
    "p"
   ],
   "expr": "p.minimum_payment if p.type == 'credit_card' else p.instalment_amount",
   "src": "A25"
  },
  "band_name": {
   "params": [
    "d"
   ],
   "expr": "'early' if between(d, 1, 7) else ('late' if between(d, 8, 45) else None)",
   "src": "A18"
  },
  "band_deadline": {
   "params": [
    "d"
   ],
   "expr": "12 if between(d, 1, 7) else 7",
   "src": "A18"
  },
  "band_attempts": {
   "params": [
    "d"
   ],
   "expr": "1 if between(d, 1, 7) else 2",
   "src": "A18"
  },
  "min_date": {
   "params": [
    "a",
    "b"
   ],
   "expr": "a if date_le(a, b) else b",
   "src": ""
  },
  "now_time": {
   "params": [],
   "expr": "time_of(call.now)",
   "src": "A6"
  }
 }
}